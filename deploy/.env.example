# Datastore credentials for deploy/docker-compose.yml.
# Copy to deploy/.env and set a real password; the compose file refuses to
# start without one rather than shipping a default nobody remembers to change.

POSTGRES_DB=kasbbook
POSTGRES_USER=kasbbook
POSTGRES_PASSWORD=

# Both are published on loopback only. Change these if the ports clash with
# something else on the host.
POSTGRES_PORT=5435
REDIS_PORT=6382
