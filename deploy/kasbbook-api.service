# The HTTP API.
#
# Bound to loopback on purpose. Anything public goes through the reverse proxy
# already on this box, which is where TLS and rate limiting at the edge belong —
# not in the application process.
#
# Access logging is off because nginx already does it, and uvicorn's version
# writes the full request path — which for a webhook contains the secret that
# guards it. One access log is enough, and it should be the one that knows to
# leave that path out.

[Unit]
Description=KasbBook API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kasbbook
EnvironmentFile=/opt/kasbbook/.env
ExecStart=/opt/kasbbook/venv/bin/uvicorn \
    --factory kasbbook.api.app:create_app \
    --host 127.0.0.1 \
    --port 8210 \
    --workers 2 \
    --proxy-headers \
    --no-server-header \
    --no-access-log
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kasbbook
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
