# KasbBook — environment.
#
# Copy to .env and fill in. On a server the installer writes this file for you
# with generated secrets; this copy is for running it by hand.
#
#   cp .env.example .env
#
# Every variable below has a safe default except the bot token and the API
# signing key, which cannot have one. Full reference, in English and Persian:
#
#   https://emadhabibnia1385.github.io/KasbBook/configuration/
#   https://emadhabibnia1385.github.io/KasbBook/fa/configuration/


# ── The bot ──────────────────────────────────────────────────────────────────

# Which messenger THIS process serves: telegram | bale | rubika.
# One process runs one provider. A second messenger is a second unit with its
# own copy of this file, sharing the same database.
KASBBOOK_PROVIDER=telegram

# The running provider reads its own variables, so a Bale process cannot
# silently start with the Telegram token. Fill in the block you are using.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Telegram echoes this in a header on every webhook delivery, and it is the
# only provider that signs anything. Leave empty in polling mode.
TELEGRAM_WEBHOOK_SECRET=

# BALE_BOT_TOKEN=
# BALE_BOT_USERNAME=
# RUBIKA_BOT_TOKEN=
# RUBIKA_BOT_USERNAME=


# ── Datastores ───────────────────────────────────────────────────────────────

# SQLite by default so the bot runs without standing up PostgreSQL first.
# Production overrides it:
#   postgresql+asyncpg://kasbbook:PASSWORD@127.0.0.1:5435/kasbbook
KASBBOOK_DATABASE_URL=sqlite+aiosqlite:///kasbbook.db

# Without Redis, conversation state and rate limiting are per-process —
# correct on one worker, wrong across several. The API warns at startup.
# REDIS_URL=redis://127.0.0.1:6382/0


# ── The API ──────────────────────────────────────────────────────────────────

# Signs access tokens. The API refuses to start without it. Generate it,
# never type it:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
KASBBOOK_SECRET_KEY=

# Access tokens are not looked up, so they are short. Refresh tokens are looked
# up on every use, so they can be revoked.
KASBBOOK_ACCESS_MINUTES=30
KASBBOOK_REFRESH_DAYS=30

# Comma-separated. Never `*` — these endpoints carry credentials. Off entirely
# when unset.
# KASBBOOK_CORS_ORIGINS=https://panel.example.com

# Set ONLY when a proxy you run is in front. It makes X-Forwarded-For trusted
# for rate limiting; without a real proxy anyone can set that header and rate
# limiting becomes decorative.
# KASBBOOK_TRUSTED_PROXY=127.0.0.1

# Where the API is published. The bot links to <url>/docs from its API screen;
# unset means no link rather than a dead one.
# KASBBOOK_API_URL=https://kasbbook.example.com

# Base URL used in links the bot sends.
# KASBBOOK_WEB_URL=

# The written guide the bot links to beside the API reference. Defaults to this
# project's published site, which documents the software rather than your
# deployment. Point it at your own if your copy has drifted, or set it to
# nothing at all to drop the button.
# KASBBOOK_DOCS_URL=https://emadhabibnia1385.github.io/KasbBook/fa/


# ── How updates arrive ───────────────────────────────────────────────────────

# polling | webhook.
#
# Polling holds an outbound connection and needs nothing reachable from
# outside — including from behind NAT. A webhook needs a public HTTPS endpoint
# and loses updates that arrive while the API is restarting, because a provider
# retries for a while and then gives up.
KASBBOOK_UPDATE_MODE=polling

# The unguessable segment in /api/v1/webhooks/<provider>/<secret>. Required in
# webhook mode. Generate it, never choose it:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
#
# Bale and Rubika sign nothing, so for them this path is the only thing
# standing in the way — which means nothing may log it. The nginx block turns
# access_log off for it and the systemd unit passes --no-access-log.
# KASBBOOK_WEBHOOK_PATH=


# ── Logging ──────────────────────────────────────────────────────────────────

# httpx and httpcore are pinned to WARNING regardless of this, because they log
# full request URLs and every bot API puts the token in the path. A token has
# reached a journal here that way once already.
KASBBOOK_LOG_LEVEL=INFO
