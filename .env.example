# Telegram Bot Token (from @BotFather)
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Numeric Telegram ID of the main admin.
# Also the default destination for automatic backups.
ADMIN_CHAT_ID=123456789

# Telegram username of the main admin (without @).
# Shown to users who are not authorised yet, so they know who to contact.
ADMIN_USERNAME=admin_username

# Optional. Set this only if the main admin's *user id* differs from the chat id
# above (for example when backups are sent to a group or channel).
# Defaults to ADMIN_CHAT_ID when omitted.
# PRIMARY_ADMIN_USER_ID=123456789
